#!/bin/bash
set -euo pipefail
LOCKFILE="/tmp/calamares.lock"
if [[ -e "$LOCKFILE" ]] && kill -0 "$(cat "$LOCKFILE" 2>/dev/null)" 2>/dev/null; then
    echo "Calamares is already running."
    exit 1
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

DIR="/etc/calamares"
if [[ -d /run/archiso/copytoram ]]; then
    sudo sed -i -e 's|/run/archiso/bootmnt/arch/x86_64/airootfs.sfs|/run/archiso/copytoram/airootfs.sfs|g' "$DIR/modules/unpackfs.conf"
fi
pkexec calamares -d || sudo -E calamares -d
