#!/bin/bash
set -euo pipefail

if ! id liveuser >/dev/null 2>&1; then
    useradd -m -u 1000 -G wheel,audio,video,storage,optical,lp,network,power,rfkill -s /bin/bash liveuser
fi

passwd -d liveuser >/dev/null 2>&1 || true
passwd -d root >/dev/null 2>&1 || true

install -d -o liveuser -g liveuser /home/liveuser/Desktop
install -d -o liveuser -g liveuser /home/liveuser/.config/autostart

if [[ -f /usr/share/applications/oozy-install.desktop ]]; then
    install -o liveuser -g liveuser -m 0755 /usr/share/applications/oozy-install.desktop /home/liveuser/Desktop/Install-Oozy-Linux.desktop
fi

if [[ -f /usr/share/applications/oozy-welcome.desktop ]]; then
    install -o liveuser -g liveuser -m 0644 /usr/share/applications/oozy-welcome.desktop /home/liveuser/.config/autostart/oozy-welcome.desktop
fi

systemctl enable sddm.service >/dev/null 2>&1 || true
systemctl enable NetworkManager.service >/dev/null 2>&1 || true
systemctl enable bluetooth.service >/dev/null 2>&1 || true
